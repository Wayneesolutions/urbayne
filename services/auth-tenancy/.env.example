PORT=4000
DATABASE_URL=postgres://user:pass@localhost:5432/election

# Super Admin lives ONLY here, never in the database.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me-to-a-long-random-string
# Optional, safer: put a bcrypt hash here instead and leave SUPER_ADMIN_PASSWORD empty.
# Generate: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
SUPER_ADMIN_PASSWORD_HASH=

# min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
SUPER_ADMIN_JWT_EXPIRES_IN=2h
