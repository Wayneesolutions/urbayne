domain_name         = "api-in.example.com"
acm_certificate_arn = "arn:aws:acm:ap-south-1:111111111111:certificate/xxxxxxxx"
route53_zone_id     = ""                      # optional
container_image     = "111111111111.dkr.ecr.ap-south-1.amazonaws.com/campaign-suite-in-prod:2027-01-15-abcdef1"
alarm_email         = "ops@example.com"

app_env = {
  OTP_PROVIDER          = "dlt"
  DLT_SENDER_ID         = "WAYNES"                                                     # your registered 6-letter header
  DLT_OTP_TEMPLATE_ID   = "1007123456789012345"
  DLT_OTP_TEMPLATE_TEXT = "Your login code is {#var#}. Valid for 5 minutes. Do not share it."
  FX_USD_TO_INR         = "85"
  SENTRY_ENVIRONMENT    = "prod-in"
}

# Secrets: put them in a file that is NOT committed (for example secrets.auto.tfvars), or pass with -var.
# provider_secrets = {
#   VAPI_API_KEY         = "..."
#   VAPI_PHONE_NUMBER_ID = "..."
#   VAPI_ASSISTANT_ID    = "..."
#   VAPI_WEBHOOK_SECRET  = "at-least-16-characters-random"
#   DLT_AUTH_KEY         = "..."
#   SENTRY_DSN           = "https://..."
# }
