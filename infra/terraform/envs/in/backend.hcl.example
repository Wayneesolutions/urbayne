# Create the bucket and lock table in the SAME AWS region first (private, versioned, encrypted). Then:
#   terraform init -backend-config=backend.hcl
bucket         = "campaign-suite-tfstate-ap-south-1-ACCOUNT"
key            = "campaign-suite/in/terraform.tfstate"
region         = "ap-south-1"
encrypt        = true
dynamodb_table = "campaign-suite-tflock"
