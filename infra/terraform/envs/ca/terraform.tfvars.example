domain_name         = "api-ca.example.com"
acm_certificate_arn = "arn:aws:acm:ca-central-1:111111111111:certificate/xxxxxxxx"
route53_zone_id     = ""                      # optional
container_image     = "111111111111.dkr.ecr.ca-central-1.amazonaws.com/campaign-suite-ca-prod:2026-09-15-abcdef1"
alarm_email         = "ops@example.com"

app_env = {
  OTP_PROVIDER       = "twilio"
  FX_USD_TO_CAD      = "1.40"
  SENTRY_ENVIRONMENT = "prod-ca"
}

