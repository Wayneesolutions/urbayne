# Copy to .env. Never commit real secrets.
DATABASE_URL=postgres://cs:cs@localhost:5432/campaign_suite
# App role used at runtime; RLS applies to it (the owner role bypasses RLS).
APP_DATABASE_URL=postgres://cs_app:cs_app@localhost:5432/campaign_suite
# Local without Docker: pnpm redis:local, then REDIS_URL=redis://localhost:6380
# Required in production. Without it rate limits, sessions and call runs live in one process (one server only).
REDIS_URL=redis://localhost:6379
# Run background workers (call runs, reminders) inside the API process. false = use dedicated 'pnpm worker' processes.
RUN_WORKERS=true
WORKER_CONCURRENCY=4
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too
# Region this deployment serves: IN or CA (one deployment per data region)
DEPLOY_REGION=IN
# OTP delivery: "console" logs codes locally; real providers come in phase 1
OTP_PROVIDER=console
PORT=4000
# 32-byte keys, base64. Generate: openssl rand -base64 32
PHONE_ENC_KEY=
PHONE_HASH_KEY=
PUBLIC_BASE_URL=http://localhost:4000
# DEMO/DEV ONLY: returns the login code in the API response. Refused when NODE_ENV=production.
DEV_RETURN_OTP=false
# Live voice (Vapi) and SMS (Twilio, Canada). Demo campaigns never use these.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Optional: lets the assistant rephrase approved answers. Without it, it quotes approved text.
ANTHROPIC_API_KEY=
