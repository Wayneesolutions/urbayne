# Copy to .env. Never commit real secrets.
DATABASE_URL=postgres://cs:cs@localhost:5432/campaign_suite
# App role used at runtime; RLS applies to it (the owner role bypasses RLS).
APP_DATABASE_URL=postgres://cs_app:cs_app@localhost:5432/campaign_suite
# Local without Docker: pnpm redis:local, then REDIS_URL=redis://localhost:6380
# Required in production. Without it rate limits, sessions and call runs live in one process (one server only).
REDIS_URL=redis://localhost:6379
# Run background workers (call runs, reminders) inside the API process. false = use dedicated 'pnpm worker' processes.
RUN_WORKERS=true
WORKER_CONCURRENCY=4
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too
# Region this deployment serves: IN or CA (one deployment per data region)
DEPLOY_REGION=IN
PORT=4000
# 32-byte keys, base64. Generate: openssl rand -base64 32
PHONE_ENC_KEY=
PHONE_HASH_KEY=
PUBLIC_BASE_URL=http://localhost:4000
# Email for password reset links. Without SMTP_URL (development only) the email and its link are written to the log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Campaign Suite <no-reply@localhost>
# DEMO/DEV ONLY: the forgot-password answer includes the reset token, so a demo works without a mail server. Refused in production.
DEV_RETURN_RESET_TOKEN=false
# First super admin: created at startup while no super admin exists (must change the password at first sign-in). Remove the password afterwards.
# SUPERADMIN_EMAIL=you@example.com
# SUPERADMIN_PASSWORD=a-long-temporary-password
# Live voice (Vapi) and SMS (Twilio, Canada). Demo campaigns never use these.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=            # at least 16 characters: openssl rand -hex 24
VAPI_RECORDING=false            # keep Vapi's audio recordings (off by default)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Optional: lets the assistant rephrase approved answers. Without it, it quotes approved text.
ANTHROPIC_API_KEY=

# Provider costs are billed in USD; converted for the spending register. Keep these current.
FX_USD_TO_INR=85
FX_USD_TO_CAD=1.4
# Signs evidence PDFs (HMAC). Required in production: openssl rand -hex 32
EVIDENCE_SIGNING_KEY=

# Error reports (optional). Without a DSN errors are only in the logs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# India SMS (DLT provider, MSG91). Header = your registered 6-letter sender header.
DLT_AUTH_KEY=
DLT_SENDER_ID=

# Secret rotation: keep the old value here while tokens signed with it are valid, then remove it (see docs/security.md).
# JWT_SECRET_PREVIOUS=
# JWT_REFRESH_SECRET_PREVIOUS=
# EVIDENCE_SIGNING_KEY_PREVIOUS=
# Production: the real password for the cs_app database role, set by the migrator (24+ characters).
# APP_ROLE_PASSWORD=

# Uploaded files (receipts, bank statements, roll copies, voice recordings). Production: s3, in this deployment's own region.
STORAGE_DRIVER=local
FILES_LOCAL_DIR=.files
# FILES_BUCKET=campaign-suite-files-in
# FILES_REGION=ap-south-1          # must be ap-south-1 for IN, ca-central-1 for CA
# Dashboard maps and road routing (optional)
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# ROUTING_BASE_URL=https://your-osrm-server
